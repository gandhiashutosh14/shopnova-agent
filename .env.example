# Copy to .env (git-ignored) or export these before running the orchestrator.

# Required for any real conversation. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LOCAL_MODE=1 runs the four tools in-process, keeps sessions in memory and logs
# escalations to stdout. No Google Cloud project, Firestore or Pub/Sub needed.
LOCAL_MODE=1

# Cloud deployment settings (ignored when LOCAL_MODE=1)
PROJECT_ID=your-project-id
REGION=us-central1
ESCALATION_TOPIC=shopnova-escalations

# Optional: point individual tools at custom URLs (e.g. functions-framework on localhost)
# TOOL_URL_GET_ORDER_STATUS=http://localhost:8081
# TOOL_URL_INITIATE_RETURN=http://localhost:8082
# TOOL_URL_ISSUE_REFUND=http://localhost:8083
# TOOL_URL_SEARCH_KNOWLEDGE_BASE=http://localhost:8084

# Flask port
PORT=8080
